{
	"autoload": {
		"directories": ["controllers", "library", "listeners", "views"]
	},
	"routing": "routing.json",
	"frontend": "frontend",
	"languages": {
		"fa_IR": "langs/fa_IR.json",
		"en_US": "langs/en_US.json"
	},
	"events": [
		{
			"name":"packages/userpanel/Events/UserTypePermissionsList",
			"listener": "packages/userpanel_oauth/Listeners/Settings/UserType@permissions"
		},
		{
			"name":"packages/userpanel/Events/AuthenticationHandlersEvent",
			"listener": "packages/userpanel_oauth/Listeners/AuthenticationHandlers@add"
		},
		{
			"name":"packages/userpanel/Events/Users/BeforeDelete",
			"listener": "packages/userpanel_oauth/Listeners/UserPanel/Users/BeforeDelete@check"
		}
	]
}